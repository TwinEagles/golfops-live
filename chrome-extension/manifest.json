{
  "manifest_version": 3,
  "name": "GolfOps Live",
  "version": "1.0.2",
  "description": "Automatically sends ForeTees Proshop Print/Report tee sheets to GolfOps Live.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://web.foretees.com/*",
    "https://*.foretees.com/*",
    "https://golfops-live.vercel.app/*"
  ],

  "options_page": "options.html",

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://web.foretees.com/*",
        "https://*.foretees.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}