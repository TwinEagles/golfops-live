{
  "manifest_version": 3,
  "name": "GolfOps Live",
  "version": "1.3.1",
  "description": "Sends ForeTees tee sheets, lessons, bag-slot and day-of changes, SchedulePop staffing, and read-only PACE cart status to GolfOps Live.",
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://web.foretees.com/*",
    "https://*.foretees.com/*",
    "https://app.schedulepop.com/*",
    "https://api.schedulepop.com/*",
    "https://www.tekgps.net/*",
    "https://tekgps.net/*",
    "https://golfops-live.vercel.app/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.foretees.com/*",
        "https://*.foretees.com/*"
      ],
      "exclude_matches": [
        "https://web.foretees.com/v5/assets/legacy/admin_welns.htm*",
        "https://*.foretees.com/v5/assets/legacy/admin_welns.htm*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.foretees.com/v5/assets/legacy/admin_welns.htm*",
        "https://*.foretees.com/v5/assets/legacy/admin_welns.htm*",
        "https://web.foretees.com/v5/servlet/Admin_*",
        "https://*.foretees.com/v5/servlet/Admin_*"
      ],
      "js": [
        "foretees-admin.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://app.schedulepop.com/*"
      ],
      "js": [
        "schedulepop-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.schedulepop.com/*"
      ],
      "js": [
        "schedulepop.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tekgps.net/main*",
        "https://tekgps.net/main*"
      ],
      "js": [
        "pace.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tekgps.net/main*",
        "https://tekgps.net/main*"
      ],
      "js": [
        "pace-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
