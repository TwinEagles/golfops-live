{
  "manifest_version": 3,
  "name": "GolfOps Live",
  "version": "1.1.0",
  "description": "Sends ForeTees tee sheets, lessons, and SchedulePop staffing schedules to GolfOps Live.",
"permissions": [
  "storage",
  "webRequest"
],
  "host_permissions": [
    "https://web.foretees.com/*",
    "https://*.foretees.com/*",
    "https://app.schedulepop.com/*",
    "https://api.schedulepop.com/*",
    "https://golfops-live.vercel.app/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.foretees.com/*",
        "https://*.foretees.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.schedulepop.com/*"
      ],
      "js": [
        "schedulepop-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.schedulepop.com/*"
      ],
      "js": [
        "schedulepop.js"
      ],
      "run_at": "document_start"
    }
  ]
}
